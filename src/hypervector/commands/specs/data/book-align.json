{
  "schema": 2,
  "help": "Align recorded L2 orderbook snapshots (JSONL) with OHLCV bars",
  "kind": "inprocess",
  "handler": "hypervector.commands.market:cmd_book_align",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [
    "market"
  ],
  "fragment_overrides": {},
  "legacy": [
    "book-align"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--book-path"
      ],
      "options": {
        "dest": "book_path",
        "default": null,
        "help": "L2 orderbook snapshot JSONL (as written by data book-record)"
      },
      "required": true
    },
    {
      "flags": [
        "--min-coverage"
      ],
      "options": {
        "dest": "min_coverage",
        "type": "float",
        "default": null,
        "help": "opt-in: fail (exit 1) when fewer than this fraction 0..1 of bars carry a book snapshot (default: report only)"
      }
    },
    {
      "flags": [
        "--max-cache-age-hours"
      ],
      "options": {
        "dest": "max_cache_age_hours",
        "type": "positive_finite_float",
        "default": null,
        "help": "refresh a cached window only when its last bar is older than this many hours (default: 24)"
      }
    },
    {
      "flags": [
        "--pin-cache"
      ],
      "options": {
        "dest": "pin_cache",
        "action": "store_true",
        "default": false,
        "help": "serve an existing cached window as is, whatever its age or coverage (reproduce a run on an installed archive window)"
      }
    }
  ]
}
