{
  "schema": 2,
  "help": "Record Hyperliquid public L2 snapshots as JSON lines under cache/book/",
  "kind": "inprocess",
  "handler": "hypervector.commands.market:cmd_book_record",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "book-record"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--symbol"
      ],
      "options": {
        "dest": "symbol",
        "default": "BTC",
        "help": "Hyperliquid coin, e.g. BTC, kPEPE or xyz:TSLA"
      }
    },
    {
      "flags": [
        "--interval-seconds"
      ],
      "options": {
        "dest": "interval_seconds",
        "type": "float",
        "default": 2.0,
        "help": "seconds between snapshots"
      },
      "legacy_flags": [
        "--interval"
      ]
    },
    {
      "flags": [
        "--once"
      ],
      "options": {
        "dest": "once",
        "action": "store_true",
        "default": false,
        "help": "write a single snapshot and exit"
      }
    },
    {
      "flags": [
        "--max-snapshots"
      ],
      "options": {
        "dest": "max_snapshots",
        "type": "int",
        "default": null,
        "help": "stop after N snapshots (omit to run until the stop file appears)"
      }
    },
    {
      "flags": [
        "--stop-file"
      ],
      "options": {
        "dest": "stop_file",
        "default": null,
        "help": "stop when this path exists"
      }
    }
  ]
}
