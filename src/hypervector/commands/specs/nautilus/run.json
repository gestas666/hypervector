{
  "schema": 2,
  "help": "Backtest a strict strategy bundle event by event with NautilusTrader",
  "kind": "inprocess",
  "handler": "hypervector.commands.nautilus:cmd_phase2_run",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "phase2-run"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--export"
      ],
      "options": {
        "dest": "export",
        "default": null,
        "help": "strategy bundle directory"
      },
      "required": true,
      "legacy_flags": [
        "--path"
      ]
    },
    {
      "flags": [
        "--lookback-days"
      ],
      "options": {
        "dest": "lookback",
        "type": "lookback_days",
        "default": null,
        "help": "calendar days of history (default: the bundle's lookback)"
      },
      "legacy_flags": [
        "--lookback"
      ]
    },
    {
      "flags": [
        "--conviction"
      ],
      "options": {
        "dest": "conviction",
        "type": "float",
        "default": 0.5,
        "help": "position-sizing conviction (0..1)"
      }
    },
    {
      "flags": [
        "--no-network"
      ],
      "options": {
        "dest": "no_network",
        "action": "store_true",
        "default": false,
        "help": "load history from the local cache without a network refresh"
      }
    }
  ]
}
