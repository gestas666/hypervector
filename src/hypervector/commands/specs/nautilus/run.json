{
  "schema": 2,
  "help": "Backtest a strict strategy bundle event by event with NautilusTrader",
  "kind": "inprocess",
  "handler": "hypervector.commands.nautilus:cmd_run",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "phase2-run"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--export"
      ],
      "options": {
        "dest": "export",
        "default": null,
        "help": "strategy bundle: a directory, a candidate id under exports/, or latest"
      },
      "required": true,
      "legacy_flags": [
        "--path"
      ]
    },
    {
      "flags": [
        "--lookback-days"
      ],
      "options": {
        "dest": "lookback",
        "type": "lookback_days",
        "default": null,
        "help": "calendar days of history (default: the bundle's lookback)"
      },
      "legacy_flags": [
        "--lookback"
      ]
    },
    {
      "flags": [
        "--conviction"
      ],
      "options": {
        "dest": "conviction",
        "type": "float",
        "default": null,
        "help": "position-sizing conviction 0..1 (default: the bundle's meta.conviction, else its risk.default_conviction)"
      }
    },
    {
      "flags": [
        "--signal-mode"
      ],
      "options": {
        "dest": "signal_mode",
        "choices": [
          "auto",
          "windowed",
          "precomputed"
        ],
        "default": "auto",
        "help": "auto precomputes signals when a causal probe agrees, else replays windowed; precomputed fails instead of falling back"
      }
    },
    {
      "flags": [
        "--no-network"
      ],
      "options": {
        "dest": "no_network",
        "action": "store_true",
        "default": false,
        "help": "read history only from the local cache; a cache miss exits 1"
      }
    }
  ]
}
