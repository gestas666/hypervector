{
  "schema": 2,
  "help": "Load a strategy bundle as a Nautilus loadout and probe the engine offline",
  "kind": "inprocess",
  "handler": "hypervector.commands.nautilus:cmd_phase2_check",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "phase2-check"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--export"
      ],
      "options": {
        "dest": "export",
        "default": null,
        "help": "strategy bundle directory"
      },
      "required": true,
      "legacy_flags": [
        "--path"
      ]
    },
    {
      "flags": [
        "--loose"
      ],
      "options": {
        "dest": "loose",
        "action": "store_true",
        "default": false,
        "help": "accept bundles without the strict execution fields"
      }
    },
    {
      "flags": [
        "--no-nautilus-probe"
      ],
      "options": {
        "dest": "no_nautilus_probe",
        "action": "store_true",
        "default": false,
        "help": "skip the offline Nautilus import and config probe"
      }
    }
  ]
}
