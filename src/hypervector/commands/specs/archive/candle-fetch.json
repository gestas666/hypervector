{
  "schema": 2,
  "help": "Fetch bounded Hyperliquid-native OHLCV candles from 0xArchive",
  "kind": "inprocess",
  "handler": "hypervector.cli_oxa:cmd_oxa_candle_fetch",
  "authority": "none",
  "environment": [
    "oxa"
  ],
  "data_root": "honored",
  "include": [
    "window"
  ],
  "fragment_overrides": {},
  "legacy": [
    "oxa-candle-fetch"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--symbol"
      ],
      "options": {
        "dest": "symbol",
        "default": "BTC",
        "help": "Hyperliquid coin (core) or deployer:asset (HIP-3)"
      }
    },
    {
      "flags": [
        "--market-family"
      ],
      "options": {
        "dest": "market_family",
        "choices": [
          "core",
          "hip3"
        ],
        "default": "core",
        "help": "0xArchive market family: core perps or HIP-3 builder markets"
      }
    },
    {
      "flags": [
        "--timeframe"
      ],
      "options": {
        "dest": "timeframe",
        "choices": [
          "1m",
          "5m",
          "15m",
          "30m",
          "1h",
          "4h",
          "1d",
          "1w"
        ],
        "default": "1m",
        "help": "candle bar size"
      },
      "legacy_flags": [
        "--interval"
      ]
    },
    {
      "flags": [
        "--limit"
      ],
      "options": {
        "dest": "limit",
        "type": "int",
        "default": 10000,
        "help": "candles per page (1..10000)"
      }
    },
    {
      "flags": [
        "--max-pages"
      ],
      "options": {
        "dest": "max_pages",
        "type": "int",
        "default": 20,
        "help": "maximum pages to request"
      }
    },
    {
      "flags": [
        "--timeout-seconds"
      ],
      "options": {
        "dest": "timeout",
        "type": "float",
        "default": 30.0,
        "help": "HTTP request timeout in seconds"
      },
      "legacy_flags": [
        "--timeout"
      ]
    },
    {
      "flags": [
        "--install-research-cache"
      ],
      "options": {
        "dest": "install_research_cache",
        "action": "store_true",
        "default": false,
        "help": "also install 1m candles as an exact research cache"
      }
    }
  ]
}
