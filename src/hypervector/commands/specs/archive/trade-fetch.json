{
  "schema": 2,
  "help": "Fetch bounded Hyperliquid public trades from 0xArchive",
  "kind": "inprocess",
  "handler": "hypervector.cli_oxa:cmd_oxa_trade_fetch",
  "authority": "none",
  "environment": [
    "oxa"
  ],
  "data_root": "honored",
  "include": [
    "window"
  ],
  "fragment_overrides": {},
  "legacy": [
    "oxa-trade-fetch"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--symbol"
      ],
      "options": {
        "dest": "symbol",
        "default": "BTC",
        "help": "Hyperliquid coin (core) or deployer:asset (HIP-3)"
      }
    },
    {
      "flags": [
        "--market-family"
      ],
      "options": {
        "dest": "market_family",
        "choices": [
          "core",
          "hip3"
        ],
        "default": "core",
        "help": "0xArchive market family: core perps or HIP-3 builder markets"
      }
    },
    {
      "flags": [
        "--limit"
      ],
      "options": {
        "dest": "limit",
        "type": "page_limit",
        "default": 1000,
        "help": "rows per page (1..1000)"
      }
    },
    {
      "flags": [
        "--max-pages"
      ],
      "options": {
        "dest": "max_pages",
        "type": "int",
        "default": 1,
        "help": "maximum pages to request"
      }
    },
    {
      "flags": [
        "--timeout-seconds"
      ],
      "options": {
        "dest": "timeout",
        "type": "float",
        "default": 30.0,
        "help": "HTTP request timeout in seconds"
      },
      "legacy_flags": [
        "--timeout"
      ]
    }
  ]
}
