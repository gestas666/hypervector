{
  "schema": 2,
  "help": "Fetch bounded Hyperliquid liquidation labels from 0xArchive (core markets)",
  "kind": "inprocess",
  "handler": "hypervector.cli_oxa_liquidations:cmd_oxa_liquidation_fetch",
  "authority": "none",
  "environment": [
    "oxa"
  ],
  "data_root": "honored",
  "include": [
    "window"
  ],
  "fragment_overrides": {},
  "legacy": [
    "oxa-liquidation-fetch"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--symbol"
      ],
      "options": {
        "dest": "symbol",
        "default": "BTC",
        "help": "Hyperliquid core coin (BTC, kPEPE); HIP-3 deployer:asset markets are not supported"
      }
    },
    {
      "flags": [
        "--limit"
      ],
      "options": {
        "dest": "limit",
        "type": "page_limit",
        "default": 1000,
        "help": "rows per page (1..1000)"
      }
    },
    {
      "flags": [
        "--max-pages"
      ],
      "options": {
        "dest": "max_pages",
        "type": "int",
        "default": 250,
        "help": "maximum pages to request; a window that needs more is refused and nothing is stored"
      }
    },
    {
      "flags": [
        "--timeout-seconds"
      ],
      "options": {
        "dest": "timeout",
        "type": "float",
        "default": 30.0,
        "help": "HTTP request timeout in seconds"
      },
      "legacy_flags": [
        "--timeout"
      ]
    },
    {
      "flags": [
        "--allow-partial"
      ],
      "options": {
        "dest": "allow_partial",
        "action": "store_true",
        "default": false,
        "help": "store an unfinished window under a non-canonical <bundle>_partial directory that backfill, audit and db build never read"
      }
    }
  ]
}
