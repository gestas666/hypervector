{
  "schema": 2,
  "help": "Paper/shadow daemon on mainnet bars with synthetic fills; never places venue orders",
  "kind": "inprocess",
  "handler": "hypervector.commands.paper:cmd_paper_run",
  "authority": "none",
  "environment": [
    "models"
  ],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "paper-run"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--export"
      ],
      "options": {
        "dest": "export",
        "default": null,
        "help": "strategy bundle directory"
      },
      "required": true,
      "legacy_flags": [
        "--path"
      ]
    },
    {
      "flags": [
        "--mode"
      ],
      "options": {
        "dest": "mode",
        "choices": [
          "paper",
          "shadow"
        ],
        "default": "shadow",
        "help": "shadow (mainnet-honest intents, no venue orders) or paper (offline synthetic fills)"
      }
    },
    {
      "flags": [
        "--conviction"
      ],
      "options": {
        "dest": "conviction",
        "type": "float",
        "default": 0.5,
        "help": "position-sizing conviction (0..1)"
      }
    },
    {
      "flags": [
        "--fee-tier"
      ],
      "options": {
        "dest": "fee_tier",
        "type": "int",
        "default": 0,
        "help": "Hyperliquid fee tier index for the cost model"
      }
    },
    {
      "flags": [
        "--interval-seconds"
      ],
      "options": {
        "dest": "interval_seconds",
        "type": "float",
        "default": 5.0,
        "help": "seconds between REST candle polls"
      },
      "legacy_flags": [
        "--poll-interval"
      ]
    },
    {
      "flags": [
        "--max-live-bars"
      ],
      "options": {
        "dest": "max_live_bars",
        "type": "int",
        "default": null,
        "help": "stop after N live bars"
      }
    },
    {
      "flags": [
        "--lookback-days"
      ],
      "options": {
        "dest": "lookback",
        "type": "lookback_days",
        "default": null,
        "help": "warm-up calendar days (default: the bundle's lookback, else 90)"
      },
      "legacy_flags": [
        "--lookback"
      ]
    },
    {
      "flags": [
        "--preferred-fill-model"
      ],
      "options": {
        "dest": "preferred_fill_model",
        "default": "l2_walk_v1",
        "help": "fill model used while the book is fresh (falls back to bar_close)"
      }
    },
    {
      "flags": [
        "--max-book-age-ms"
      ],
      "options": {
        "dest": "max_book_age_ms",
        "type": "float",
        "default": 3000.0,
        "help": "book age in milliseconds after which fills fall back"
      }
    },
    {
      "flags": [
        "--metalabel-mode"
      ],
      "options": {
        "dest": "metalabel_mode",
        "choices": [
          "off",
          "observe",
          "scale",
          "filter"
        ],
        "default": null,
        "help": "metalabel policy: off, observe (annotate), scale (size by p) or filter (size and gate by p)"
      }
    },
    {
      "flags": [
        "--metalabel-min-p"
      ],
      "options": {
        "dest": "metalabel_min_p",
        "type": "float",
        "default": 0.5,
        "help": "minimum metalabel probability (0..1) to allow an entry when filtering"
      }
    },
    {
      "flags": [
        "--stop-file"
      ],
      "options": {
        "dest": "stop_file",
        "default": null,
        "help": "stop gracefully when this path exists"
      }
    },
    {
      "flags": [
        "--metalabel"
      ],
      "options": {
        "dest": "metalabel",
        "action": "boolean_optional",
        "help": "compatibility switch for --metalabel-mode"
      },
      "hidden": true
    },
    {
      "flags": [
        "--metalabel-filter"
      ],
      "options": {
        "dest": "metalabel_filter",
        "action": "boolean_optional",
        "help": "compatibility switch for --metalabel-mode filter"
      },
      "hidden": true
    }
  ]
}
