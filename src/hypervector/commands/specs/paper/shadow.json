{
  "schema": 2,
  "help": "Run the validated Hypervelocity shadow backend from its runtime profile",
  "kind": "inprocess",
  "handler": "hypervector.commands.shadow:cmd_hypervelocity_shadow_run",
  "authority": "none",
  "environment": [
    "models"
  ],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "paper shadow-run",
    "hypervelocity-shadow-run"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--config"
      ],
      "options": {
        "dest": "config",
        "type": "Path",
        "default": "configs/hypervelocity_faithful.toml",
        "help": "Hypervelocity runtime profile TOML"
      }
    },
    {
      "flags": [
        "--max-live-bars"
      ],
      "options": {
        "dest": "max_live_bars",
        "type": "int",
        "default": null,
        "help": "stop after N live bars (bounded smoke run)"
      }
    }
  ]
}
