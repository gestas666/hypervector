{
  "schema": 2,
  "help": "Compare backend shadow runs with a same-window real-strategy log",
  "kind": "inprocess",
  "handler": "hypervector.commands.replay:cmd_hypervelocity_shadow_compare",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "research shadow-compare",
    "hypervelocity-shadow-compare"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--shadow-ledger"
      ],
      "options": {
        "dest": "shadow_ledger",
        "default": null,
        "help": "backend shadow decisions JSONL"
      },
      "required": true
    },
    {
      "flags": [
        "--positions"
      ],
      "options": {
        "dest": "positions",
        "default": null,
        "help": "same-window real-strategy positions CSV"
      },
      "required": true
    },
    {
      "flags": [
        "--run-id"
      ],
      "options": {
        "dest": "run_id",
        "action": "append",
        "default": null,
        "help": "backend run ID; repeat for long and short runs"
      },
      "required": true
    },
    {
      "flags": [
        "--entry-tolerance-seconds"
      ],
      "options": {
        "dest": "entry_tolerance_seconds",
        "type": "float",
        "default": 120.0,
        "help": "maximum entry time difference in seconds for a match"
      }
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "type": "Path",
        "default": null,
        "help": "optional JSON report path"
      }
    }
  ]
}
