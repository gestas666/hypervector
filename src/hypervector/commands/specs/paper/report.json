{
  "schema": 2,
  "help": "Summarize paper/shadow decisions (fill models, modes, intents, honesty counters)",
  "kind": "inprocess",
  "handler": "hypervector.commands.paper:cmd_paper_report",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "paper-report"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--decisions"
      ],
      "options": {
        "dest": "decisions",
        "type": "Path",
        "default": null,
        "help": "paper decisions JSONL"
      },
      "legacy_flags": [
        "--path"
      ],
      "data_default": "paper/decisions/decisions.jsonl"
    },
    {
      "flags": [
        "--last"
      ],
      "options": {
        "dest": "last",
        "type": "int",
        "default": 5,
        "help": "number of recent market fills in the sample"
      }
    },
    {
      "flags": [
        "--run-id"
      ],
      "options": {
        "dest": "run_id",
        "default": null,
        "help": "summarize only this paper run id"
      }
    },
    {
      "flags": [
        "--strategy"
      ],
      "options": {
        "dest": "strategy",
        "default": null,
        "help": "summarize only decisions of this strategy"
      }
    }
  ]
}
