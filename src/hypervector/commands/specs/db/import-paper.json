{
  "schema": 2,
  "help": "Import paper/shadow ledger evidence into DuckDB",
  "kind": "inprocess",
  "handler": "hypervector.cli_oxa:cmd_research_db_shadow_import",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
