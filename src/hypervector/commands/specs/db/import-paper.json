      },
      "legacy_flags": [
        "--ledger"
      ],
      "data_default": "paper/decisions/decisions.jsonl"
    },
    {
      "flags": [
        "--database"
      ],
      "options": {
        "dest": "database",
        "type": "Path",
        "default": null,
        "help": "DuckDB research database file"
      },
      "data_default": "research/market.duckdb"
    }
  ]
}
