{
  "name": "autotune",
  "action": "autotune",
  "help": "Run Karpathy / Optuna TPE parameter autotuning for strategy optimization (VectorBT engine)",
  "handler": "hypervector.commands.autotune:cmd_autotune",
  "arguments": [
    {
      "flags": [
        "--symbol"
      ],
      "options": {
        "dest": "symbol",
        "default": "BTC"
      }
    },
    {
      "flags": [
        "--timeframe"
      ],
      "options": {
        "dest": "timeframe",
        "default": "1m"
      }
    },
    {
      "flags": [
        "--lookback"
      ],
      "options": {
        "dest": "lookback",
        "default": 90,
        "help": "calendar days (floor=30, default=90, promo=180)",
        "type": "int"
      }
    },
    {
      "flags": [
        "--strict-hl-only"
      ],
      "options": {
        "dest": "strict_hl_only",
        "default": false,
        "help": "do not backfill from Binance/Bybit",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--force"
      ],
      "options": {
        "dest": "force",
        "default": false,
        "help": "ignore Parquet cache and re-fetch",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--strategy"
      ],
      "options": {
        "dest": "strategy",
        "default": "crown_stack_long",
        "help": "strategy name (e.g. crown_stack_long, pine_composite_long, crown_stack_short)"
      }
    },
    {
      "flags": [
        "--n-trials"
      ],
      "options": {
        "dest": "n_trials",
        "default": 100,
        "help": "number of Optuna/Karpathy trial iterations (default 100)",
        "type": "int"
      }
    },
    {
      "flags": [
        "--fee-model"
      ],
      "options": {
        "dest": "fee_model",
        "default": "hl_taker_default",
        "help": "cost model: hl_taker_default | hl_taker_tight | zero"
      }
    },
    {
      "flags": [
        "--book-path"
      ],
      "options": {
        "dest": "book_path",
        "default": null,
        "help": "optional orderbook L2 data path (JSONL or SQLite)"
      }
    },
    {
      "flags": [
        "--sampler"
      ],
      "options": {
        "dest": "sampler",
        "default": "karpathy",
        "help": "search sampler: hybrid | karpathy (random-adaptive + elite zoom) | optuna (TPE)",
        "choices": [
          "hybrid",
          "karpathy",
          "optuna"
        ]
      }
    },
    {
      "flags": [
        "--no-export"
      ],
      "options": {
        "dest": "no_export",
        "default": false,
        "help": "do not automatically export best strategy configuration",
        "action": "store_true"
      }
    }
  ]
}
