{
  "name": "research-economics",
  "action": "economics",
  "help": "Reconcile recorded strategy economics and funding capacity without execution",
  "handler": "hypervector.commands.operations:run_operation",
  "operation": "strategy_economic_reset",
  "arguments": [
    {
      "flags": [
        "--checkpoint"
      ],
      "options": {
        "dest": "checkpoint",
        "type": "Path",
        "required": true
      }
    },
    {
      "flags": [
        "--funding"
      ],
      "options": {
        "dest": "funding",
        "type": "Path",
        "required": true,
        "action": "append"
      }
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "type": "Path",
        "required": true
      }
    }
  ]
}
