{
  "name": "hypervelocity-shadow-compare",
  "action": "shadow-compare",
  "help": "Compare backend shadow runs with a same-window real-strategy log",
  "handler": "hypervector.commands.replay:cmd_hypervelocity_shadow_compare",
  "arguments": [
    {
      "flags": [
        "--shadow-ledger"
      ],
      "options": {
        "dest": "shadow_ledger",
        "required": true,
        "default": null
      }
    },
    {
      "flags": [
        "--positions"
      ],
      "options": {
        "dest": "positions",
        "required": true,
        "default": null
      }
    },
    {
      "flags": [
        "--run-id"
      ],
      "options": {
        "dest": "run_id",
        "required": true,
        "default": null,
        "help": "explicit backend run ID; repeat for long and short runs",
        "action": "append"
      }
    },
    {
      "flags": [
        "--entry-tolerance-seconds"
      ],
      "options": {
        "dest": "entry_tolerance_seconds",
        "default": 120.0,
        "type": "float"
      }
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "default": null
      }
    }
  ]
}
