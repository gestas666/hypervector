{
  "name": "research-db-regime-label-import",
  "action": "db-regime-label-import",
  "help": "Import source-pinned Hypertrader labels into DuckDB",
  "handler": "hypervector.cli_oxa:cmd_research_db_regime_label_import",
  "arguments": [
    {
      "flags": [
        "--labels"
      ],
      "options": {
        "dest": "labels",
        "required": true,
        "default": null,
        "type": "Path"
      }
    },
    {
      "flags": [
        "--metadata"
      ],
      "options": {
        "dest": "metadata",
        "required": true,
        "default": null,
        "type": "Path"
      }
    },
    {
      "flags": [
        "--database"
      ],
      "options": {
        "dest": "database",
        "default": null,
        "type": "Path"
      }
    }
  ]
}
