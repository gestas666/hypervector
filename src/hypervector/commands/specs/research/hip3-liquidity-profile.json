{
  "name": "research-hip3-liquidity-profile",
  "action": "hip3-liquidity-profile",
  "help": "Measure point-in-time HIP-3 visible liquidity without execution",
  "handler": "hypervector.cli_hip3_research:cmd_hip3_liquidity_profile",
  "arguments": [
    {
      "flags": [
        "--database"
      ],
      "options": {
        "dest": "database",
        "required": true,
        "default": null,
        "type": "Path"
      }
    },
    {
      "flags": [
        "--symbol"
      ],
      "options": {
        "dest": "symbol",
        "required": true,
        "default": null
      }
    },
    {
      "flags": [
        "--notional-usd"
      ],
      "options": {
        "dest": "notional_usd",
        "default": null,
        "type": "float",
        "action": "append"
      }
    },
    {
      "flags": [
        "--sample-minutes"
      ],
      "options": {
        "dest": "sample_minutes",
        "default": 5,
        "type": "int"
      }
    },
    {
      "flags": [
        "--maximum-boundary-delay-ms"
      ],
      "options": {
        "dest": "maximum_boundary_delay_ms",
        "default": 15000,
        "type": "int"
      }
    },
    {
      "flags": [
        "--account-maker-rate"
      ],
      "options": {
        "dest": "account_maker_rate",
        "default": null,
        "type": "float"
      }
    },
    {
      "flags": [
        "--account-taker-rate"
      ],
      "options": {
        "dest": "account_taker_rate",
        "default": null,
        "type": "float"
      }
    },
    {
      "flags": [
        "--active-referral-discount"
      ],
      "options": {
        "dest": "active_referral_discount",
        "default": null,
        "type": "float"
      }
    },
    {
      "flags": [
        "--deployer-fee-scale"
      ],
      "options": {
        "dest": "deployer_fee_scale",
        "default": null,
        "type": "float"
      }
    },
    {
      "flags": [
        "--growth-mode"
      ],
      "options": {
        "dest": "growth_mode",
        "default": null,
        "action": "boolean_optional"
      }
    },
    {
      "flags": [
        "--aligned-quote"
      ],
      "options": {
        "dest": "aligned_quote",
        "default": null,
        "action": "boolean_optional"
      }
    },
    {
      "flags": [
        "--aligned-quote-status"
      ],
      "options": {
        "dest": "aligned_quote_status",
        "default": null
      }
    },
    {
      "flags": [
        "--fee-evidence-label"
      ],
      "options": {
        "dest": "fee_evidence_label",
        "default": null
      }
    },
    {
      "flags": [
        "--output"
      ],
      "options": {
        "dest": "output",
        "default": null,
        "type": "Path"
      }
    }
  ]
}
