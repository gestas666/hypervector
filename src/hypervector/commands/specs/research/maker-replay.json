{
  "name": "hypervelocity-maker-replay",
  "action": "maker-replay",
  "help": "Replay canonical Hypervelocity decisions against recorded L2 books",
  "handler": "hypervector.commands.replay:cmd_hypervelocity_maker_replay",
  "arguments": [
    {
      "flags": [
        "--symbol"
      ],
      "options": {
        "dest": "symbol",
        "default": "BTC"
      }
    },
    {
      "flags": [
        "--timeframe"
      ],
      "options": {
        "dest": "timeframe",
        "default": "1m"
      }
    },
    {
      "flags": [
        "--lookback"
      ],
      "options": {
        "dest": "lookback",
        "default": 90,
        "help": "calendar days (floor=30, default=90, promo=180)",
        "type": "int"
      }
    },
    {
      "flags": [
        "--strict-hl-only"
      ],
      "options": {
        "dest": "strict_hl_only",
        "default": false,
        "help": "do not backfill from Binance/Bybit",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--force"
      ],
      "options": {
        "dest": "force",
        "default": false,
        "help": "ignore Parquet cache and re-fetch",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--book-path"
      ],
      "options": {
        "dest": "book_path",
        "default": null,
        "action": "append"
      }
    },
    {
      "flags": [
        "--trade-path"
      ],
      "options": {
        "dest": "trade_path",
        "default": null,
        "action": "append"
      }
    },
    {
      "flags": [
        "--archive-start"
      ],
      "options": {
        "dest": "archive_start",
        "default": null,
        "type": "_parse_utc_datetime"
      }
    },
    {
      "flags": [
        "--archive-end"
      ],
      "options": {
        "dest": "archive_end",
        "default": null,
        "type": "_parse_utc_datetime"
      }
    },
    {
      "flags": [
        "--fill-rule"
      ],
      "options": {
        "dest": "fill_rule",
        "default": "both",
        "choices": [
          "both",
          "all",
          "touch",
          "through",
          "trade-through"
        ]
      }
    },
    {
      "flags": [
        "--initial-equity"
      ],
      "options": {
        "dest": "initial_equity",
        "default": 10000.0,
        "type": "float"
      }
    },
    {
      "flags": [
        "--maker-fee-rate"
      ],
      "options": {
        "dest": "maker_fee_rate",
        "default": 0.00015,
        "type": "float"
      }
    },
    {
      "flags": [
        "--taker-fee-rate"
      ],
      "options": {
        "dest": "taker_fee_rate",
        "default": 0.00045,
        "type": "float"
      }
    },
    {
      "flags": [
        "--tick-size"
      ],
      "options": {
        "dest": "tick_size",
        "default": 1.0,
        "type": "float"
      }
    },
    {
      "flags": [
        "--entry-ttl-seconds"
      ],
      "options": {
        "dest": "entry_ttl_seconds",
        "default": 300.0,
        "type": "float"
      }
    },
    {
      "flags": [
        "--labels-out"
      ],
      "options": {
        "dest": "labels_out",
        "default": null,
        "type": "Path"
      }
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "default": null
      }
    }
  ]
}
