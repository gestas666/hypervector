{
  "name": "research-db-shadow-import",
  "action": "db-shadow-import",
  "help": "Import paper/shadow ledger evidence into DuckDB for analysis",
  "handler": "hypervector.cli_oxa:cmd_research_db_shadow_import",
  "arguments": [
    {
      "flags": [
        "--ledger"
      ],
      "options": {
        "dest": "ledger",
        "default": null,
        "help": "ledger path (default: <data-root>/paper/decisions/decisions.jsonl)",
        "type": "Path"
      }
    },
    {
      "flags": [
        "--database"
      ],
      "options": {
        "dest": "database",
        "default": null,
        "type": "Path"
      }
    }
  ]
}
