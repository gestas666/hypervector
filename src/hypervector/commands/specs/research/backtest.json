{
  "name": "backtest",
  "action": "backtest",
  "help": "Run Phase-1.5 backtest across any registered strategy with leverage & fee models (VectorBT engine)",
  "handler": "hypervector.commands.backtest:cmd_backtest",
  "arguments": [
    {
      "flags": [
        "--symbol"
      ],
      "options": {
        "dest": "symbol",
        "default": "BTC"
      }
    },
    {
      "flags": [
        "--timeframe"
      ],
      "options": {
        "dest": "timeframe",
        "default": "1m"
      }
    },
    {
      "flags": [
        "--lookback"
      ],
      "options": {
        "dest": "lookback",
        "default": 90,
        "help": "calendar days (floor=30, default=90, promo=180)",
        "type": "int"
      }
    },
    {
      "flags": [
        "--strict-hl-only"
      ],
      "options": {
        "dest": "strict_hl_only",
        "default": false,
        "help": "do not backfill from Binance/Bybit",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--force"
      ],
      "options": {
        "dest": "force",
        "default": false,
        "help": "ignore Parquet cache and re-fetch",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--strategy"
      ],
      "options": {
        "dest": "strategy",
        "default": "crown_stack_long",
        "help": "strategy name (e.g. crown_stack_long, oi_divergence_long, funding_momentum, pine_composite_long)"
      }
    },
    {
      "flags": [
        "--leverage"
      ],
      "options": {
        "dest": "leverage",
        "default": 2.0,
        "help": "position leverage scaling factor 1.0-10.0 (default 2.0)",
        "type": "float"
      }
    },
    {
      "flags": [
        "--init-cash"
      ],
      "options": {
        "dest": "init_cash",
        "default": 10000.0,
        "help": "starting portfolio balance USD (default 10000.0)",
        "type": "float"
      }
    },
    {
      "flags": [
        "--fee-model"
      ],
      "options": {
        "dest": "fee_model",
        "default": "hl_maker",
        "help": "fee preset: hl_maker | hl_base_taker | hl_referred_taker | hl_vip1_taker"
      }
    },
    {
      "flags": [
        "--exit-mode"
      ],
      "options": {
        "dest": "exit_mode",
        "default": "atr",
        "help": "exit mode: atr | fixed_rr | trail"
      }
    },
    {
      "flags": [
        "--sl-atr-mult"
      ],
      "options": {
        "dest": "sl_atr_mult",
        "default": 2.5,
        "help": "ATR stop loss multiplier (default 2.5)",
        "type": "float"
      }
    },
    {
      "flags": [
        "--rr"
      ],
      "options": {
        "dest": "rr",
        "default": 3.0,
        "help": "risk/reward ratio (default 3.0)",
        "type": "float"
      }
    },
    {
      "flags": [
        "--book-gate"
      ],
      "options": {
        "dest": "book_gate",
        "default": false,
        "help": "enable orderbook entry gating filter",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--max-spread-bps"
      ],
      "options": {
        "dest": "max_spread_bps",
        "default": 3.0,
        "help": "max bid-ask spread in bps for book gating (default 3.0)",
        "type": "float"
      }
    },
    {
      "flags": [
        "--min-obi"
      ],
      "options": {
        "dest": "min_obi",
        "default": 0.1,
        "help": "min orderbook imbalance ratio for book gating (default 0.10)",
        "type": "float"
      }
    },
    {
      "flags": [
        "--book-path"
      ],
      "options": {
        "dest": "book_path",
        "default": null,
        "help": "optional orderbook L2 snapshot data path (JSONL or SQLite)"
      }
    }
  ]
}
