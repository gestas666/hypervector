{
  "schema": 2,
  "help": "Cohort start readiness as booleans: credentials, authority, profile, STOP and drain",
  "section": "run",
  "kind": "inprocess",
  "handler": "hypervector.commands.live:cmd_live_check",
  "authority": "simulate",
  "environment": [],
  "data_root": "refused",
  "data_root_reason": "cohort readiness reads the profile's own paths and the process environment",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "live-check"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--config"
      ],
      "options": {
        "dest": "config",
        "type": "Path",
        "default": null,
        "help": "cohort profile TOML to check (loaded in observe mode only)"
      }
    },
    {
      "flags": [
        "--enabled"
      ],
      "options": {
        "dest": "enabled",
        "action": "store_true",
        "default": false,
        "help": "simulate the first live-authority flag"
      }
    },
    {
      "flags": [
        "--i-accept-live-risk"
      ],
      "options": {
        "dest": "i_accept_live_risk",
        "action": "store_true",
        "default": false,
        "help": "simulate the second live-authority flag"
      },
      "legacy_flags": [
        "--armed"
      ]
    }
  ]
}
