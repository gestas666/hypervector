{
  "name": "live-check",
  "action": "check",
  "help": "Live readiness: secrets present (bool), arm/enabled gates, max notional, submit_wired (no secret values; no place)",
  "handler": "hypervector.commands.status:cmd_live_check",
  "arguments": [
    {
      "flags": [
        "--enabled"
      ],
      "options": {
        "dest": "enabled",
        "default": false,
        "help": "simulate [live] enabled=true for readiness (default false)",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--armed"
      ],
      "options": {
        "dest": "armed",
        "default": false,
        "help": "simulate --i-accept-live-risk arm for readiness (default false)",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--max-notional-usd"
      ],
      "options": {
        "dest": "max_notional_usd",
        "default": 50.0,
        "help": "max notional cap for policy (default 50.0)",
        "type": "float"
      }
    }
  ]
}
