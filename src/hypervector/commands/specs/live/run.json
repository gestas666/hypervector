{
  "schema": 2,
  "help": "Generic single-bundle live daemon (requires --enabled, --i-accept-live-risk and credentials)",
  "section": "run",
  "kind": "inprocess",
  "handler": "hypervector.commands.live:cmd_live_run",
  "authority": "live",
  "environment": [
    "live-credentials"
  ],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "live-run"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--export"
      ],
      "options": {
        "dest": "export",
        "default": null,
        "help": "strict strategy bundle directory"
      },
      "required": true,
      "legacy_flags": [
        "--path"
      ]
    },
    {
      "flags": [
        "--enabled"
      ],
      "options": {
        "dest": "enabled",
        "action": "store_true",
        "default": false,
        "help": "first of the two live-authority flags (required to run)"
      }
    },
    {
      "flags": [
        "--i-accept-live-risk"
      ],
      "options": {
        "dest": "i_accept_live_risk",
        "action": "store_true",
        "default": false,
        "help": "second of the two live-authority flags (required to run)"
      }
    },
    {
      "flags": [
        "--max-notional-usd"
      ],
      "options": {
        "dest": "max_notional_usd",
        "type": "float",
        "default": 50.0,
        "help": "hard notional cap per order in USD"
      }
    },
    {
      "flags": [
        "--conviction"
      ],
      "options": {
        "dest": "conviction",
        "type": "float",
        "default": 0.5,
        "help": "position-sizing conviction (0..1)"
      }
    },
    {
      "flags": [
        "--fee-tier"
      ],
      "options": {
        "dest": "fee_tier",
        "type": "int",
        "default": 0,
        "help": "Hyperliquid fee tier index for the cost model"
      }
    },
    {
      "flags": [
        "--stop-file"
      ],
      "options": {
        "dest": "stop_file",
        "default": null,
        "help": "stop gracefully when this path exists"
      }
    },
    {
      "flags": [
        "--interval-seconds"
      ],
      "options": {
        "dest": "interval_seconds",
        "type": "float",
        "default": 5.0,
        "help": "seconds between bar polls"
      },
      "legacy_flags": [
        "--poll-interval"
      ]
    },
    {
      "flags": [
        "--max-live-bars"
      ],
      "options": {
        "dest": "max_live_bars",
        "type": "int",
        "default": null,
        "help": "stop after N live bars"
      }
    },
    {
      "flags": [
        "--lookback-days"
      ],
      "options": {
        "dest": "lookback",
        "type": "lookback_days",
        "default": null,
        "help": "warm-up calendar days (default: the bundle's lookback)"
      },
      "legacy_flags": [
        "--lookback"
      ]
    }
  ]
}
