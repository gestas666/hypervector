{
  "schema": 2,
  "help": "Summarize generic live-daemon decisions (read-only)",
  "section": "observe",
  "kind": "inprocess",
  "handler": "hypervector.commands.live:cmd_live_report",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "live-report"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--decisions"
      ],
      "options": {
        "dest": "decisions",
        "type": "Path",
        "default": null,
        "help": "live decisions JSONL"
      },
      "legacy_flags": [
        "--path"
      ],
      "data_default": "live/decisions/decisions.jsonl"
    },
    {
      "flags": [
        "--last"
      ],
      "options": {
        "dest": "last",
        "type": "int",
        "default": 5,
        "help": "number of recent market fills in the sample"
      }
    }
  ]
}
