{
  "schema": 2,
  "help": "Tune Hypervelocity regime parameters against recorded entries (chronological holdout)",
  "kind": "inprocess",
  "handler": "hypervector.commands.regime:cmd_regime_tune",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [
    "market"
  ],
  "fragment_overrides": {},
  "legacy": [
    "regime autotune",
    "hypervelocity-regime-autotune"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--positions"
      ],
      "options": {
        "dest": "positions",
        "default": null,
        "help": "recorded-entries CSV with open_time_utc, side and symbol"
      },
      "required": true
    },
    {
      "flags": [
        "--n-trials"
      ],
      "options": {
        "dest": "n_trials",
        "type": "int",
        "default": 100,
        "help": "number of candidate parameter sets"
      }
    },
    {
      "flags": [
        "--seed"
      ],
      "options": {
        "dest": "seed",
        "type": "int",
        "default": 7,
        "help": "random seed for candidate generation"
      }
    },
    {
      "flags": [
        "--train-fraction"
      ],
      "options": {
        "dest": "train_fraction",
        "type": "float",
        "default": 0.7,
        "help": "chronological share of entries used for training (0..1)"
      }
    },
    {
      "flags": [
        "--forward-bars"
      ],
      "options": {
        "dest": "forward_horizon",
        "type": "int",
        "default": 30,
        "help": "forward bars used to score breakout targets"
      },
      "legacy_flags": [
        "--forward-horizon"
      ]
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "type": "Path",
        "default": null,
        "help": "write the durable tuning board here instead of logs/research (refused if the file exists)"
      }
    },
    {
      "flags": [
        "--max-cache-age-hours"
      ],
      "options": {
        "dest": "max_cache_age_hours",
        "type": "positive_finite_float",
        "default": null,
        "help": "refresh a cached window only when its last bar is older than this many hours (default: 24)"
      }
    },
    {
      "flags": [
        "--pin-cache"
      ],
      "options": {
        "dest": "pin_cache",
        "action": "store_true",
        "default": false,
        "help": "serve an existing cached window as is, whatever its age or coverage (reproduce a run on an installed archive window)"
      }
    }
  ],
  "description": "Tune causal regime parameters against recorded entries with a chronological holdout. Every run writes a durable board with its data provenance under <data-root>/logs/research/regime_autotune_<UTC>.json (exclusive create), or at --out, which must not exist yet."
}
