{
  "schema": 2,
  "help": "Backtest one registered strategy with leverage, fees and exits (VectorBT)",
  "kind": "inprocess",
  "handler": "hypervector.commands.backtest:cmd_backtest",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [
    "market",
    "fees",
    "cash",
    "exits"
  ],
  "fragment_overrides": {},
  "legacy": [
    "research backtest"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--strategy"
      ],
      "options": {
        "dest": "strategy",
        "default": null,
        "help": "registered strategy name (required; families register in hypervector.strategies.STRATEGY_FAMILY_MODULES)"
      }
    },
    {
      "flags": [
        "--leverage"
      ],
      "options": {
        "dest": "leverage",
        "type": "float",
        "default": 2.0,
        "help": "leverage = position notional / equity; refused above the venue cap (BTC 40, ETH 25, SOL 20, HYPE and other perps 10)"
      }
    },
    {
      "flags": [
        "--book-gate"
      ],
      "options": {
        "dest": "book_gate",
        "action": "store_true",
        "default": false,
        "help": "gate entries on recorded orderbook spread and imbalance"
      }
    },
    {
      "flags": [
        "--max-spread-bps"
      ],
      "options": {
        "dest": "max_spread_bps",
        "type": "float",
        "default": 3.0,
        "help": "maximum bid-ask spread in basis points for the book gate"
      }
    },
    {
      "flags": [
        "--min-obi"
      ],
      "options": {
        "dest": "min_obi",
        "type": "float",
        "default": 0.1,
        "help": "minimum orderbook imbalance (0..1) for the book gate"
      }
    },
    {
      "flags": [
        "--book-path"
      ],
      "options": {
        "dest": "book_path",
        "default": null,
        "help": "optional L2 orderbook snapshot JSONL (as written by data book-record) aligned to the bars"
      }
    },
    {
      "flags": [
        "--max-cache-age-hours"
      ],
      "options": {
        "dest": "max_cache_age_hours",
        "type": "positive_finite_float",
        "default": null,
        "help": "refresh a cached window only when its last bar is older than this many hours (default: 24)"
      }
    },
    {
      "flags": [
        "--pin-cache"
      ],
      "options": {
        "dest": "pin_cache",
        "action": "store_true",
        "default": false,
        "help": "serve an existing cached window as is, whatever its age or coverage (reproduce a run on an installed archive window)"
      }
    }
  ]
}
