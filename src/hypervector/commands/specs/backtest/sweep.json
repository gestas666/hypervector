{
  "schema": 2,
  "help": "Grid-search one strategy track and store every trial on the board (VectorBT)",
  "kind": "inprocess",
  "handler": "hypervector.commands.sweep:cmd_sweep",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [
    "market",
    "fees",
    "cash",
    "exits",
    "risk"
  ],
  "fragment_overrides": {},
  "legacy": [
    {
      "words": "research sweep-up",
      "insert": [
        "--track",
        "uptrend"
      ]
    },
    {
      "words": "sweep-up",
      "insert": [
        "--track",
        "uptrend"
      ]
    },
    {
      "words": "research sweep-down",
      "insert": [
        "--track",
        "downtrend"
      ]
    },
    {
      "words": "sweep-down",
      "insert": [
        "--track",
        "downtrend"
      ]
    }
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--track"
      ],
      "options": {
        "dest": "track",
        "choices": [
          "uptrend",
          "downtrend"
        ],
        "default": null,
        "help": "strategy track to search: uptrend (long) or downtrend (short)"
      },
      "required": true
    },
    {
      "flags": [
        "--strategy"
      ],
      "options": {
        "dest": "strategy",
        "default": null,
        "help": "strategy name (default: the track's trend_ride_*, then crown_stack_*)"
      }
    },
    {
      "flags": [
        "--no-costs"
      ],
      "options": {
        "dest": "no_costs",
        "action": "store_true",
        "default": false,
        "help": "disable fees, slippage and funding (debug only)"
      }
    },
    {
      "flags": [
        "--leverage"
      ],
      "options": {
        "dest": "leverage",
        "type": "float",
        "default": 1.0,
        "help": "leverage = position notional / equity for every trial; refused above the venue cap (BTC 40, ETH 25, SOL 20, HYPE and other perps 10)"
      }
    },
    {
      "flags": [
        "--no-export"
      ],
      "options": {
        "dest": "no_export",
        "action": "store_true",
        "default": false,
        "help": "do not write the best trial as a strategy bundle"
      }
    },
    {
      "flags": [
        "--export"
      ],
      "options": {
        "dest": "no_export",
        "action": "store_false",
        "help": "accepted for compatibility; exporting is the default"
      },
      "hidden": true
    },
    {
      "flags": [
        "--max-cache-age-hours"
      ],
      "options": {
        "dest": "max_cache_age_hours",
        "type": "positive_finite_float",
        "default": null,
        "help": "refresh a cached window only when its last bar is older than this many hours (default: 24)"
      }
    },
    {
      "flags": [
        "--pin-cache"
      ],
      "options": {
        "dest": "pin_cache",
        "action": "store_true",
        "default": false,
        "help": "serve an existing cached window as is, whatever its age or coverage (reproduce a run on an installed archive window)"
      }
    }
  ]
}
