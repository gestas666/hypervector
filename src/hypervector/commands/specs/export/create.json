{
  "schema": 2,
  "help": "Write the best stored sweep trial matching the filters as a strict strategy bundle",
  "kind": "inprocess",
  "handler": "hypervector.commands.export:cmd_create",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "research export"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--track"
      ],
      "options": {
        "dest": "track",
        "choices": [
          "uptrend",
          "downtrend"
        ],
        "default": null,
        "help": "only trials from this track (give --track, --run-id or both)"
      }
    },
    {
      "flags": [
        "--run-id"
      ],
      "options": {
        "dest": "run_id",
        "default": null,
        "help": "only trials from this sweep run id (give --track, --run-id or both)"
      }
    },
    {
      "flags": [
        "--strategy"
      ],
      "options": {
        "dest": "strategy",
        "default": null,
        "help": "only trials of this registered strategy name"
      }
    },
    {
      "flags": [
        "--symbol"
      ],
      "options": {
        "dest": "symbol",
        "default": null,
        "help": "only trials measured on this Hyperliquid coin, e.g. BTC"
      }
    },
    {
      "flags": [
        "--timeframe"
      ],
      "options": {
        "dest": "timeframe",
        "default": null,
        "help": "only trials measured on this bar size, e.g. 5m"
      }
    }
  ]
}
