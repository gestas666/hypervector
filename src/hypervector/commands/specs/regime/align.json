{
  "schema": 2,
  "help": "Report Hypervelocity regime alignment with recorded entries",
  "kind": "inprocess",
  "handler": "hypervector.commands.regime:cmd_regime_align",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [
    "market"
  ],
  "fragment_overrides": {},
  "legacy": [
    "regime hypervelocity-eval",
    "hypervelocity-regime-eval"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--positions"
      ],
      "options": {
        "dest": "positions",
        "default": null,
        "help": "recorded-entries CSV with open_time_utc, side and symbol"
      },
      "required": true
    },
    {
      "flags": [
        "--forward-bars"
      ],
      "options": {
        "dest": "forward_horizon",
        "type": "int",
        "default": 30,
        "help": "forward 1m bars used to report breakout target misses"
      },
      "legacy_flags": [
        "--forward-horizon"
      ]
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "type": "Path",
        "default": null,
        "help": "optional JSON report path"
      }
    },
    {
      "flags": [
        "--max-cache-age-hours"
      ],
      "options": {
        "dest": "max_cache_age_hours",
        "type": "positive_finite_float",
        "default": null,
        "help": "refresh a cached window only when its last bar is older than this many hours (default: 24)"
      }
    },
    {
      "flags": [
        "--pin-cache"
      ],
      "options": {
        "dest": "pin_cache",
        "action": "store_true",
        "default": false,
        "help": "serve an existing cached window as is, whatever its age or coverage (reproduce a run on an installed archive window)"
      }
    }
  ]
}
