{
  "schema": 2,
  "help": "Evaluate annotation-only point-in-time regime challengers",
  "kind": "inprocess",
  "handler": "hypervector.commands.regime:cmd_regime_challengers",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [
    "market"
  ],
  "fragment_overrides": {},
  "legacy": [
    "hypervelocity-regime-challengers"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--forward-bars"
      ],
      "options": {
        "dest": "forward_horizon",
        "type": "int",
        "default": 30,
        "help": "forward bars used to score each challenger"
      },
      "legacy_flags": [
        "--forward-horizon"
      ]
    },
    {
      "flags": [
        "--seed"
      ],
      "options": {
        "dest": "seed",
        "type": "int",
        "default": 42,
        "help": "random seed for the statistical models"
      }
    },
    {
      "flags": [
        "--n-splits"
      ],
      "options": {
        "dest": "n_splits",
        "type": "int",
        "default": 3,
        "help": "walk-forward splits"
      }
    },
    {
      "flags": [
        "--wasserstein-window"
      ],
      "options": {
        "dest": "wasserstein_window",
        "type": "int",
        "default": 60,
        "help": "bars per Wasserstein distribution window"
      }
    },
    {
      "flags": [
        "--wasserstein-sample-cap"
      ],
      "options": {
        "dest": "wasserstein_sample_cap",
        "type": "int",
        "default": 1000,
        "help": "maximum samples per Wasserstein comparison"
      }
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "type": "Path",
        "default": null,
        "help": "optional JSON report path"
      }
    }
  ]
}
