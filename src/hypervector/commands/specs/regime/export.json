{
  "name": "regime-export",
  "action": "export",
  "help": "Export real per-bar regime telemetry snapshots for tui-regime-detector",
  "handler": "hypervector.commands.regime:cmd_regime_export",
  "arguments": [
    {
      "flags": [
        "--symbol"
      ],
      "options": {
        "dest": "symbol",
        "default": "BTC"
      }
    },
    {
      "flags": [
        "--timeframe"
      ],
      "options": {
        "dest": "timeframe",
        "default": "1m"
      }
    },
    {
      "flags": [
        "--lookback"
      ],
      "options": {
        "dest": "lookback",
        "default": 90,
        "help": "calendar days (floor=30, default=90, promo=180)",
        "type": "int"
      }
    },
    {
      "flags": [
        "--strict-hl-only"
      ],
      "options": {
        "dest": "strict_hl_only",
        "default": false,
        "help": "do not backfill from Binance/Bybit",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--force"
      ],
      "options": {
        "dest": "force",
        "default": false,
        "help": "ignore Parquet cache and re-fetch",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--bars"
      ],
      "options": {
        "dest": "bars",
        "default": 1500,
        "help": "number of most recent bars to export (default 1500)",
        "type": "int"
      }
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "default": null,
        "help": "output JSON path (default <data-root>/exports/regime_snapshots.json)"
      }
    },
    {
      "flags": [
        "--book-path"
      ],
      "options": {
        "dest": "book_path",
        "default": null,
        "help": "optional orderbook L2 data path (JSONL) to align microstructure features"
      }
    }
  ]
}
