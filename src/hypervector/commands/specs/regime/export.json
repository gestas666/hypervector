{
  "schema": 2,
  "help": "Export per-bar regime telemetry snapshots as JSON",
  "kind": "inprocess",
  "handler": "hypervector.commands.regime:cmd_regime_export",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [
    "market"
  ],
  "fragment_overrides": {},
  "legacy": [
    "regime-export"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--bars"
      ],
      "options": {
        "dest": "bars",
        "type": "int",
        "default": 1500,
        "help": "most recent bars to export"
      }
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "type": "Path",
        "default": null,
        "help": "output JSON file"
      },
      "data_default": "exports/regime_snapshots.json"
    },
    {
      "flags": [
        "--book-path"
      ],
      "options": {
        "dest": "book_path",
        "default": null,
        "help": "optional L2 snapshot JSONL aligned to the bars"
      }
    }
  ]
}
