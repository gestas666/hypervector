{
  "schema": 2,
  "help": "Export per-bar regime telemetry snapshots as JSON",
  "kind": "inprocess",
  "handler": "hypervector.commands.regime:cmd_regime_export",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [
    "market"
  ],
  "fragment_overrides": {},
  "legacy": [
    "regime-export"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--bars"
      ],
      "options": {
        "dest": "bars",
        "type": "int",
        "default": 1500,
        "help": "most recent bars to export"
      }
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "type": "Path",
        "default": null,
        "help": "output JSON file"
      },
      "data_default": "exports/regime_snapshots.json"
    },
    {
      "flags": [
        "--book-path"
      ],
      "options": {
        "dest": "book_path",
        "default": null,
        "help": "optional L2 orderbook snapshot JSONL (as written by data book-record) aligned to the bars"
      }
    },
    {
      "flags": [
        "--max-cache-age-hours"
      ],
      "options": {
        "dest": "max_cache_age_hours",
        "type": "positive_finite_float",
        "default": null,
        "help": "refresh a cached window only when its last bar is older than this many hours (default: 24)"
      }
    },
    {
      "flags": [
        "--pin-cache"
      ],
      "options": {
        "dest": "pin_cache",
        "action": "store_true",
        "default": false,
        "help": "serve an existing cached window as is, whatever its age or coverage (reproduce a run on an installed archive window)"
      }
    }
  ]
}
