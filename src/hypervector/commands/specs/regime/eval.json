{
  "schema": 2,
  "help": "Evaluate forward-return accuracy and edge of the canonical regime classifier",
  "kind": "inprocess",
  "handler": "hypervector.commands.regime:cmd_regime_eval",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [
    "market"
  ],
  "fragment_overrides": {},
  "legacy": [
    "regime-eval"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--forward-bars"
      ],
      "options": {
        "dest": "forward_horizon",
        "type": "int",
        "default": 15,
        "help": "forward bars used to score direction accuracy"
      },
      "legacy_flags": [
        "--forward-horizon"
      ]
    },
    {
      "flags": [
        "--book-path"
      ],
      "options": {
        "dest": "book_path",
        "default": null,
        "help": "optional L2 orderbook snapshot JSONL (as written by data book-record) aligned to the bars"
      }
    },
    {
      "flags": [
        "--max-cache-age-hours"
      ],
      "options": {
        "dest": "max_cache_age_hours",
        "type": "positive_finite_float",
        "default": null,
        "help": "refresh a cached window only when its last bar is older than this many hours (default: 24)"
      }
    },
    {
      "flags": [
        "--pin-cache"
      ],
      "options": {
        "dest": "pin_cache",
        "action": "store_true",
        "default": false,
        "help": "serve an existing cached window as is, whatever its age or coverage (reproduce a run on an installed archive window)"
      }
    }
  ]
}
