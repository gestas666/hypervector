{
  "schema": 2,
  "help": "Evaluate forward-return accuracy and edge of the canonical regime classifier",
  "kind": "inprocess",
  "handler": "hypervector.commands.regime:cmd_regime_eval",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [
    "market"
  ],
  "fragment_overrides": {},
  "legacy": [
    "regime-eval"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--forward-bars"
      ],
      "options": {
        "dest": "forward_horizon",
        "type": "int",
        "default": 15,
        "help": "forward bars used to score direction accuracy"
      },
      "legacy_flags": [
        "--forward-horizon"
      ]
    },
    {
      "flags": [
        "--book-path"
      ],
      "options": {
        "dest": "book_path",
        "default": null,
        "help": "optional L2 snapshot JSONL aligned to the bars"
      }
    }
  ]
}
