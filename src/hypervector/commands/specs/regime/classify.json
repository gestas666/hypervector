{
  "schema": 2,
  "help": "Classify regimes on cached or fetched history (EMA detector)",
  "kind": "inprocess",
  "handler": "hypervector.commands.regime:cmd_regime",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [
    "market"
  ],
  "fragment_overrides": {},
  "legacy": [],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--fast"
      ],
      "options": {
        "dest": "fast",
        "type": "int",
        "default": 12,
        "help": "fast EMA length in bars"
      }
    },
    {
      "flags": [
        "--slow"
      ],
      "options": {
        "dest": "slow",
        "type": "int",
        "default": 48,
        "help": "slow EMA length in bars"
      }
    }
  ]
}
