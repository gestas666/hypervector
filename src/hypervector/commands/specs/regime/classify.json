{
  "schema": 2,
  "help": "Classify regimes on cached or fetched history (canonical engine by default)",
  "kind": "inprocess",
  "handler": "hypervector.commands.regime:cmd_regime",
  "authority": "none",
  "environment": [],
  "data_root": "honored",
  "include": [
    "market"
  ],
  "fragment_overrides": {},
  "legacy": [],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--detector"
      ],
      "options": {
        "dest": "detector",
        "choices": [
          "canonical",
          "ema"
        ],
        "default": "canonical",
        "help": "canonical (the multi-timeframe engine 'regime eval' scores) or ema (EMA crossover)"
      }
    },
    {
      "flags": [
        "--fast"
      ],
      "options": {
        "dest": "fast",
        "type": "int",
        "default": null,
        "help": "fast EMA length in bars (ema detector only; default 12)"
      }
    },
    {
      "flags": [
        "--slow"
      ],
      "options": {
        "dest": "slow",
        "type": "int",
        "default": null,
        "help": "slow EMA length in bars (ema detector only; default 48)"
      }
    },
    {
      "flags": [
        "--max-cache-age-hours"
      ],
      "options": {
        "dest": "max_cache_age_hours",
        "type": "positive_finite_float",
        "default": null,
        "help": "refresh a cached window only when its last bar is older than this many hours (default: 24)"
      }
    },
    {
      "flags": [
        "--pin-cache"
      ],
      "options": {
        "dest": "pin_cache",
        "action": "store_true",
        "default": false,
        "help": "serve an existing cached window as is, whatever its age or coverage (reproduce a run on an installed archive window)"
      }
    }
  ]
}
