{
  "name": "hypervelocity-regime-autotune",
  "action": "autotune",
  "help": "Tune Hypervelocity regime parameters with chronological holdout",
  "handler": "hypervector.commands.regime:cmd_hypervelocity_regime_autotune",
  "arguments": [
    {
      "flags": [
        "--symbol"
      ],
      "options": {
        "dest": "symbol",
        "default": "BTC"
      }
    },
    {
      "flags": [
        "--timeframe"
      ],
      "options": {
        "dest": "timeframe",
        "default": "1m"
      }
    },
    {
      "flags": [
        "--lookback"
      ],
      "options": {
        "dest": "lookback",
        "default": 90,
        "help": "calendar days (floor=30, default=90, promo=180)",
        "type": "int"
      }
    },
    {
      "flags": [
        "--strict-hl-only"
      ],
      "options": {
        "dest": "strict_hl_only",
        "default": false,
        "help": "do not backfill from Binance/Bybit",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--force"
      ],
      "options": {
        "dest": "force",
        "default": false,
        "help": "ignore Parquet cache and re-fetch",
        "action": "store_true"
      }
    },
    {
      "flags": [
        "--positions"
      ],
      "options": {
        "dest": "positions",
        "required": true,
        "default": null,
        "help": "CSV containing open_time_utc, side, and symbol"
      }
    },
    {
      "flags": [
        "--n-trials"
      ],
      "options": {
        "dest": "n_trials",
        "default": 100,
        "type": "int"
      }
    },
    {
      "flags": [
        "--seed"
      ],
      "options": {
        "dest": "seed",
        "default": 7,
        "type": "int"
      }
    },
    {
      "flags": [
        "--train-fraction"
      ],
      "options": {
        "dest": "train_fraction",
        "default": 0.7,
        "type": "float"
      }
    },
    {
      "flags": [
        "--forward-horizon"
      ],
      "options": {
        "dest": "forward_horizon",
        "default": 30,
        "type": "int"
      }
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "default": null,
        "help": "optional path for the complete JSON tuning board"
      }
    }
  ]
}
