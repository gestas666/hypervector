{
  "schema": 2,
  "help": "Walk-forward LightGBM metalabel training on a strategy bundle's entries",
  "kind": "inprocess",
  "handler": "hypervector.commands.model:cmd_metalabel_train",
  "authority": "none",
  "environment": [
    "models"
  ],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "metalabel-train"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--export"
      ],
      "options": {
        "dest": "export",
        "default": null,
        "help": "strategy bundle directory"
      },
      "required": true,
      "legacy_flags": [
        "--path"
      ]
    },
    {
      "flags": [
        "--lookback-days"
      ],
      "options": {
        "dest": "lookback",
        "type": "lookback_days",
        "default": null,
        "help": "history calendar days (default: the bundle's lookback, else 90)"
      },
      "legacy_flags": [
        "--lookback"
      ]
    },
    {
      "flags": [
        "--train-days"
      ],
      "options": {
        "dest": "train_days",
        "type": "int",
        "default": 45,
        "help": "walk-forward train window in days"
      }
    },
    {
      "flags": [
        "--test-days"
      ],
      "options": {
        "dest": "test_days",
        "type": "int",
        "default": 15,
        "help": "walk-forward out-of-sample window in days"
      }
    },
    {
      "flags": [
        "--step-days"
      ],
      "options": {
        "dest": "step_days",
        "type": "int",
        "default": null,
        "help": "days between out-of-sample windows (default: --test-days)"
      }
    },
    {
      "flags": [
        "--embargo-minutes"
      ],
      "options": {
        "dest": "embargo_minutes",
        "type": "int",
        "default": 60,
        "help": "purged cross-validation embargo in minutes"
      }
    },
    {
      "flags": [
        "--max-hold-bars"
      ],
      "options": {
        "dest": "max_hold_bars",
        "type": "int",
        "default": 120,
        "help": "label barrier timeout in bars"
      }
    },
    {
      "flags": [
        "--out-dir"
      ],
      "options": {
        "dest": "out_dir",
        "type": "Path",
        "default": null,
        "help": "bundle output directory (default: models/metalabel/wf_<strategy>_<time> under the data root)"
      },
      "legacy_flags": [
        "--out"
      ]
    },
    {
      "flags": [
        "--install"
      ],
      "options": {
        "dest": "install",
        "action": "store_true",
        "default": false,
        "help": "also copy the trained model into models/metalabel/ under the data root"
      }
    }
  ]
}
