{
  "schema": 2,
  "help": "Command inventory, capabilities and paper/live safety flags (never prints secret values)",
  "kind": "inprocess",
  "handler": "hypervector.commands.status:cmd_status",
  "authority": "none",
  "environment": [
    "models"
  ],
  "data_root": "honored",
  "include": [],
  "fragment_overrides": {},
  "legacy": [
    "status"
  ],
  "exclusive_groups": [],
  "arguments": [
    {
      "flags": [
        "--probe-model"
      ],
      "options": {
        "dest": "probe_model",
        "action": "store_true",
        "default": false,
        "help": "load and validate the metalabel bundle under the data root"
      }
    }
  ]
}
