{
  "name": "cohort-observer-checkpoint",
  "action": "observer-checkpoint",
  "help": "Continuously publish bounded analysis for one disarmed observer ledger.",
  "handler": "hypervector.commands.operations:run_operation",
  "operation": "multi_asset_bidirectional_observer_checkpoint",
  "arguments": [
    {
      "flags": [
        "--decisions"
      ],
      "options": {
        "dest": "decisions",
        "default": "data/live/bidirectional_cohort/decisions.jsonl",
        "type": "Path"
      }
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "default": "data/runtime/bidirectional_cohort/latest_checkpoint.json",
        "type": "Path"
      }
    },
    {
      "flags": [
        "--run-id"
      ],
      "options": {
        "dest": "run_id",
        "default": null
      }
    },
    {
      "flags": [
        "--interval-seconds"
      ],
      "options": {
        "dest": "interval_seconds",
        "default": 30.0,
        "type": "float"
      }
    },
    {
      "flags": [
        "--once"
      ],
      "options": {
        "dest": "once",
        "default": false,
        "action": "store_true"
      }
    }
  ]
}
