{
  "name": "cohort-request",
  "action": "request",
  "help": "Review or explicitly publish an identity-bound operator request",
  "handler": "hypervector.commands.operator:cmd_operator_request",
  "arguments": [
    {
      "flags": [
        "--inbox"
      ],
      "options": {
        "dest": "inbox",
        "type": "Path",
        "required": true
      }
    },
    {
      "flags": [
        "--run-id"
      ],
      "options": {
        "dest": "run_id",
        "required": true
      }
    },
    {
      "flags": [
        "--profile-fingerprint"
      ],
      "options": {
        "dest": "profile_fingerprint",
        "required": true
      }
    },
    {
      "flags": [
        "--action"
      ],
      "options": {
        "dest": "action",
        "required": true,
        "choices": [
          "manual_enter",
          "manual_close",
          "transition_drain",
          "stage_profile"
        ]
      }
    },
    {
      "flags": [
        "--symbol"
      ],
      "options": {
        "dest": "symbol",
        "required": true
      }
    },
    {
      "flags": [
        "--provider"
      ],
      "options": {
        "dest": "provider",
        "default": null
      }
    },
    {
      "flags": [
        "--side"
      ],
      "options": {
        "dest": "side",
        "default": null,
        "choices": [
          "long",
          "short"
        ]
      }
    },
    {
      "flags": [
        "--settings"
      ],
      "options": {
        "dest": "settings",
        "type": "Path",
        "default": null
      }
    },
    {
      "flags": [
        "--submit"
      ],
      "options": {
        "dest": "submit",
        "action": "store_true",
        "default": false
      }
    },
    {
      "flags": [
        "--enabled"
      ],
      "options": {
        "dest": "enabled",
        "action": "store_true",
        "default": false
      }
    },
    {
      "flags": [
        "--i-accept-live-risk"
      ],
      "options": {
        "dest": "i_accept_live_risk",
        "action": "store_true",
        "default": false
      }
    }
  ]
}
