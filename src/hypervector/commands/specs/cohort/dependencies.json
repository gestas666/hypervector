{
  "name": "cohort-dependencies",
  "action": "dependencies",
  "help": "Supervise unsigned external signal sources required by a profile",
  "handler": "hypervector.commands.operations:run_operation",
  "operation": "hip3_pressure_dependency_group",
  "arguments": [
    {
      "flags": [
        "--config"
      ],
      "options": {
        "dest": "config",
        "required": true,
        "type": "Path"
      }
    },
    {
      "flags": [
        "--log-root"
      ],
      "options": {
        "dest": "log_root",
        "type": "Path",
        "default": "data/logs/pressure_dependencies"
      }
    }
  ]
}
