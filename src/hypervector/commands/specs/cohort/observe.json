{
  "name": "cohort-observe",
  "action": "observe",
  "help": "Run the production multi-asset collectors with zero execution authority.",
  "handler": "hypervector.commands.operations:run_operation",
  "operation": "multi_asset_bidirectional_observe",
  "arguments": [
    {
      "flags": [
        "--config"
      ],
      "options": {
        "dest": "config",
        "default": null,
        "type": "Path",
        "required": true
      }
    },
    {
      "flags": [
        "--backtest-lab-root"
      ],
      "options": {
        "dest": "backtest_lab_root",
        "default": "../backtest-lab/backtest_lab",
        "type": "Path"
      }
    },
    {
      "flags": [
        "--ledger-root"
      ],
      "options": {
        "dest": "ledger_root",
        "default": null,
        "help": "Rebind every observe-only ledger below an isolated directory.",
        "type": "Path"
      }
    },
    {
      "flags": [
        "--resume-run-id"
      ],
      "options": {
        "dest": "resume_run_id",
        "default": null,
        "help": "Resume only an existing observer ledger with this exact run ID."
      }
    },
    {
      "flags": [
        "--max-polls"
      ],
      "options": {
        "dest": "max_polls",
        "default": null,
        "type": "int"
      }
    }
  ]
}
