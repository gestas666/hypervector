{
  "name": "cohort-observer-audit",
  "action": "observer-audit",
  "help": "Publish immutable setup-process evidence for one disarmed cohort run.",
  "handler": "hypervector.commands.operations:run_operation",
  "operation": "multi_asset_bidirectional_observer_audit",
  "arguments": [
    {
      "flags": [
        "--decisions"
      ],
      "options": {
        "dest": "decisions",
        "default": "data/live/bidirectional_cohort/decisions.jsonl",
        "type": "Path"
      }
    },
    {
      "flags": [
        "--run-id"
      ],
      "options": {
        "dest": "run_id",
        "default": null
      }
    },
    {
      "flags": [
        "--out"
      ],
      "options": {
        "dest": "out",
        "default": null,
        "type": "Path"
      }
    },
    {
      "flags": [
        "--out-dir"
      ],
      "options": {
        "dest": "out_dir",
        "default": null,
        "type": "Path"
      }
    }
  ]
}
