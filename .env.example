# Copy to .env (gitignored). Never commit secret values.

# Live secrets (loaded only by an armed `live start` or `live run`; fail-closed without both):
# HYPERVECTOR_HL_WALLET_ADDRESS=
# HYPERVECTOR_HL_API_PRIVATE_KEY=

# Metalabel bundle root (default off; enable with `paper run --metalabel-mode observe|scale|filter`)
# Prefer project data root; absolute path is fine.
HYPERVECTOR_METALABEL_ROOT=data/models/metalabel
